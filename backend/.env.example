# Copiá este archivo como "backend/.env" y completá los valores.
# El .env no se sube al repo: cada uno tiene el suyo.

# Contraseña de tu usuario "postgres" en tu PostgreSQL local
DB_PASSWORD=tu_contraseña_de_postgres

# Credenciales de IGDB, solo necesarias para importar juegos desde IGDB.
# Se sacan creando una aplicación en https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=tu_client_id
IGDB_CLIENT_SECRET=tu_client_secret
